# Variables públicas de contacto para el sitio estático.
#
# Astro expone deliberadamente las variables que comienzan con PUBLIC_ en el
# navegador. Por ello, estos valores no son secretos y no deben contener
# claves, tokens ni credenciales de administración.

PUBLIC_FORMSPREE_FORM_ID=abcdwxyz
PUBLIC_WHATSAPP_NUMBER=593999999999
PUBLIC_CONTACT_PHONE="+593 99 999 9999"
PUBLIC_CONTACT_EMAIL=contacto@ejemplo.com
